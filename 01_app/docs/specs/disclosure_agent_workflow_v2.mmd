flowchart TB
  ENTRY["选择板块并绑定客户"] --> LOCK["固定脚本锁定法规 / 案例 / 模板三库；绑定客户历史披露库"]
  LOCK --> USER["用户自然语言描述情况或提供材料"]
  USER --> A["Agent runtime + LLM 理解并整理事实，调用 Skill A；输出义务、时点、理由或缺口"]
  A --> VA["Verify A：规则、引用、计算、缺失事实、历史披露与承诺"] --> GA{"自动 Gate A：检查结果分流"}
  GA -->|"缺少影响判断的事实"| Q["向用户反馈缺少什么信息；用户补充或纠正"]
  Q --> A
  GA -->|"可修复检查错误"| A
  GA -->|"可供审阅；显式展示争议与风险"| HA{"人工 Gate 1：确认义务判断"}
  HA -->|"不认可，提出理由"| A
  HA -->|"认可当前不披露"| MONITOR["归档理由、前提与复判条件；本次判断结束 / 持续跟踪"]
  MONITOR -.->|"新事实触发复判"| A
  HA -->|"认可：准备披露"| B["Agent + LLM 调用 Skill B；继承有效判断；输出文件清单 + 披露要求明细"]
  B --> VB["Verify B：文件、内容颗粒度、要求覆盖、材料对应、历史衔接"] --> GB{"自动 Gate B：是否可供审阅"}
  GB -->|"检查未通过，修订或补充"| B
  GB -->|"通过；保留提示项"| HB{"人工 Gate 2：确认文件与内容规划"}
  HB -->|"不认可，提出理由"| B
  HB -->|"认可规划"| T["从已锁定模板库选择 / 适配；展示模板与规划的对应关系"]
  T --> VT["Verify T：模板版本、文种、已确认要求覆盖"] --> GT{"自动 Gate T：是否适配"}
  GT -->|"不适配或无合适模板，提出调整方案"| T
  GT -->|"适配"| HT{"人工 Gate 3：确认模板"}
  HT -->|"不认可，换模板或调整"| T
  HT -->|"认可模板"| W["Agent 按已确认规划与模板组织正文；直接调用 Word 工具制稿"]
  W --> VW["Verify W：事实、数字、要求、历史口径、占位符、可打开性与实际渲染排版"] --> GW{"自动 Gate W：是否通过"}
  GW -->|"未通过"| RET["按最早受影响节点退回；受影响下游审批失效"]
  GW -->|"通过；保留提示项"| HW{"人工 Gate 4：确认最终 Word"}
  HW -->|"不认可，提出理由"| RET
  HW -->|"认可当前文件版本"| FIN["交付并归档人工确认稿；本次文件制作流程结束；尚未公开披露"]
  RET -->|"措辞 / 排版"| W
  RET -->|"模板问题"| T
  RET -->|"披露文件或要求变化"| B
  RET -->|"事实或披露义务变化"| A
  HIST[("该客户历史披露库：正式公开原文 + 事项及更正关系")]
  HIST -.->|"前期公告 / 承诺 / 进展"| A
  HIST -.->|"首次 / 进展 / 更正内容规划"| B
  HIST -.->|"最终一致性核验"| VW
  FIN -.->|"后续独立动作；不自动发布"| PUB["另行完成正式披露；核实公开来源后入历史库"]
  PUB -.-> HIST
  GUARD["全流程守卫：实质变更使相关审批失效；等待或重试不暂停时限提示；反复失败与紧急事项升级人工"]
  GUARD -.-> GA
  GUARD -.-> GW
  classDef human fill:#FFF4DD,stroke:#B58A43;
  classDef verify fill:#EDF6F0,stroke:#64917A;
  classDef process fill:#EDF3FC,stroke:#6987B1;
  class HA,HB,HT,HW human;
  class VA,VB,VT,VW verify;
  class A,B,T,W process;
